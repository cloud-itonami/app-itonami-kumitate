;; 90-cli (prefix cli-): the native command. Files are read through the
;; runtime's :fs/app-data inside KEXE_CAP_RESOURCES_35, by absolute path.
;;
;;   kumitate validate CONFIG
;;   kumitate plan|process|api|local CONFIG [--branch B] [--tag T]
;;            [--param NAME=VALUE].. [--value pipeline.NAME=VALUE]..
;;            [--slug S] [--number N] [--created-at ISO]          (api)
;;   kumitate runs FILE.json
;;   kumitate runs-export FILE.json kumitate|circleci-items
;;   kumitate junit REPORT.xml..
;;   kumitate mcp REQUEST.json          one JSON-RPC message -> its answer
;;   kumitate serve IP:PORT [LIMIT]     MCP over HTTP (needs the :net grant)
;;   kumitate selftest MANIFEST         the fixtures: SCANNED n PASS p FAIL f
;;
;; The result is 0 when the input is accepted, 1 when it is refused, 2 for a
;; usage error, and for selftest the number of failures (SCANNED 0 is 3).

(defn cli-out [s :string] :i64 (let [r (typed-cap-call :io/write :string :string s)] 0))
(defn cli-err [s :string] :i64 (let [r (typed-cap-call :io/write-error :string :string s)] 0))
(defn cli-argc [] :i64 (tx-int (typed-cap-call :cli/args :string :string "")))
(defn cli-arg [i :i64] :string (typed-cap-call :cli/args :string :string (tx-istr i)))
(defn cli-args [] [:list :string]
  (loop [i 0 acc (tx-strs)] (if (< i (cli-argc)) (recur (+ i 1) (conj acc (cli-arg i))) acc)))
;; the runtime looks for its tokens anywhere in a request, so the token is built
(defn cli-sep [w :string] :string (tx-cat w "_SEP"))
(defn cli-exists? [path :string] :bool
  (let [r (typed-cap-call :fs/app-data :string :string (tx-cat path (cli-sep "EXISTS")))]
    (and (> (tx-len r) 0) (= (tx-cp r 0) 49))))
(defn cli-read [path :string] :string (typed-cap-call :fs/app-data :string :string path))
(defn cli-dir [path :string] :string
  (loop [i (- (tx-len path) 1)] (cond (< i 0) "" (= (tx-cp path i) 47) (tx-sub path 0 (+ i 1)) :else (recur (- i 1)))))

(defrecord CO [text :string code :i64])
(defn cli-usage [] [:ref :kumitate/CO]
  (->CO "usage: kumitate validate|plan|process|api|local CONFIG [--branch B] [--tag T] [--param K=V].. [--value K=V]..\n       kumitate runs FILE | runs-export FILE FORMAT | junit XML.. | mcp REQUEST | serve IP:PORT [N] | selftest MANIFEST\n" 2))
(defn cli-json [y [:ref :kumitate/Y]] [:ref :kumitate/CO]
  (->CO (tx-cat (js-write y) "\n") (if (y-false? (y-get y "valid")) 1 0)))

;; the inputs of a pipeline from the flags after position 2
(defn cli-flags [args [:list :string] from :i64] [:ref :kumitate/Y]
  (loop [i from acc (y-map)]
    (if (>= (+ i 1) (count args)) acc
      (let [f (nth args i) v (nth args (+ i 1)) eq (string-index-of v "=")]
        (cond (tx-eq f "--branch") (recur (+ i 2) (y-set acc "branch" (y-str v)))
              (tx-eq f "--tag") (recur (+ i 2) (y-set acc "tag" (y-str v)))
              (tx-eq f "--slug") (recur (+ i 2) (y-set acc "project_slug" (y-str v)))
              (tx-eq f "--number") (recur (+ i 2) (y-set acc "number" (y-plain v)))
              (tx-eq f "--created-at") (recur (+ i 2) (y-set acc "created_at" (y-str v)))
              (and (tx-eq f "--param") (> eq 0))
                (recur (+ i 2) (y-set acc "parameters" (y-set (if (y-map? (y-get acc "parameters")) (y-get acc "parameters") (y-map)) (tx-sub v 0 eq) (y-plain (tx-from v (+ eq 1))))))
              (and (tx-eq f "--value") (> eq 0))
                (recur (+ i 2) (y-set acc "values" (y-set (if (y-map? (y-get acc "values")) (y-get acc "values") (y-map)) (tx-sub v 0 eq) (y-plain (tx-from v (+ eq 1))))))
              :else (recur (+ i 1) acc))))))
(defn cli-missing [path :string] [:ref :kumitate/CO]
  (->CO (tx-cat (js-write (mc-refusal "input/unreadable" path "no such file inside the granted directory, or not an absolute path")) "\n") 1))
(defn cli-readable? [path :string] :bool (and (tx-starts? path "/") (cli-exists? path)))

;; one command: args[0] is the command
(defn cli-run [args [:list :string]] [:ref :kumitate/CO]
  (let [n (count args) cmd (if (> n 0) (nth args 0) "") f (if (> n 1) (nth args 1) "")]
    (cond (< n 2) (cli-usage)
          (and (not (tx-eq cmd "serve")) (not (tx-eq cmd "junit")) (not (cli-readable? f))) (cli-missing f)
          (tx-eq cmd "validate") (cli-json (mc-config-tool "validate" (cli-read f) (y-map)))
          (tx-eq cmd "plan") (cli-json (mc-config-tool "plan" (cli-read f) (cli-flags args 2)))
          (tx-eq cmd "process")
            (let [y (mc-config-tool "process" (cli-read f) (cli-flags args 2))]
              (if (y-true? (y-get y "valid")) (->CO (:text (y-get y "yaml")) 0) (cli-json y)))
          (tx-eq cmd "api") (cli-json (mc-config-tool "api" (cli-read f) (cli-flags args 2)))
          (tx-eq cmd "local") (cli-json (mc-config-tool "local" (cli-read f) (cli-flags args 2)))
          (tx-eq cmd "runs") (cli-json (mc-runs (cli-read f)))
          (tx-eq cmd "runs-export")
            (if (< n 3) (cli-usage)
              (let [x (mc-runs (cli-read f))]
                (if (y-false? (y-get x "valid")) (cli-json x)
                  (let [e (mc-runs-export (y-get x "record") (nth args 2))]
                    (if (y-false? (y-get e "valid")) (cli-json e) (->CO (tx-cat (:text (y-get e "text")) "\n") 0))))))
          (tx-eq cmd "junit")
            (let [bad (loop [i 1] (cond (>= i n) "" (cli-readable? (nth args i)) (recur (+ i 1)) :else (nth args i)))]
              (if (not (tx-empty? bad)) (cli-missing bad)
                (cli-json (mc-junit (loop [i 1 acc (y-seq)] (if (< i n) (recur (+ i 1) (y-add acc (y-str (cli-read (nth args i))))) acc))))))
          (tx-eq cmd "mcp") (let [a (mc-handle (cli-read f))] (->CO (tx-cat a "\n") 0))
          :else (cli-usage))))

;; the fixtures: each line `COMMAND EXPECTED INPUT [ARGS..]`, paths relative to
;; the manifest; # starts a comment
(defn cli-selftest [manifest :string] :i64
  (let [dir (cli-dir manifest)
        lines (tx-split (cli-read manifest) "\n")
        r (loop [i 0 scanned 0 pass 0]
            (if (>= i (count lines)) [scanned pass]
              (let [l (tx-trim (nth lines i))]
                (if (or (tx-empty? l) (tx-starts? l "#")) (recur (+ i 1) scanned pass)
                  (let [t (loop [k 0 acc (tx-strs)] (let [ws (tx-split l " ")] (if (< k (count ws)) (recur (+ k 1) (if (tx-empty? (nth ws k)) acc (conj acc (nth ws k)))) acc)))
                        cmd (nth t 0) expected (tx-cat dir (nth t 1))
                        args (loop [k 2 acc (conj (tx-strs) cmd)]
                               (if (>= k (count t)) acc
                                 ;; a path is relative to the manifest: a token with / or . that is
                                 ;; no flag and no flag's value (runs-export's FORMAT is neither)
                                 (recur (+ k 1) (conj acc (if (and (not (tx-starts? (nth t k) "--"))
                                                                   (not (tx-starts? (nth t (- k 1)) "--"))
                                                                   (or (tx-has? (nth t k) "/") (tx-has? (nth t k) ".")))
                                                            (tx-cat dir (nth t k)) (nth t k))))))
                        o (cli-run args)
                        want (if (cli-readable? expected) (cli-read expected) "<missing expected file>")
                        ok (tx-eq (:text o) want)
                        z (cli-out (tx-cat4 (if ok "PASS " "FAIL ") l (if ok "" (tx-cat " -- first difference at byte " (tx-istr (cli-diff (:text o) want)))) "\n"))]
                    (recur (+ i 1) (+ scanned 1) (if ok (+ pass 1) pass)))))))
        scanned (vector-at r 0) pass (vector-at r 1)
        z (cli-out (tx-cat5 "SCANNED " (tx-istr scanned) " PASS " (tx-istr pass) (tx-cat " FAIL " (tx-cat (tx-istr (- scanned pass)) "\n"))))]
    (if (= scanned 0) 3 (- scanned pass))))
(defn cli-diff [a :string b :string] :i64
  (loop [i 0] (cond (or (>= i (tx-len a)) (>= i (tx-len b))) i
                    (= (tx-cp a i) (tx-cp b i)) (recur (+ i (tx-w (tx-cp a i))))
                    :else i)))

(defn cli-main [] :i64
  (let [args (cli-args) n (count args) cmd (if (> n 0) (nth args 0) "")]
    (cond (and (tx-eq cmd "serve") (> n 1)) (let [s (ht-serve (nth args 1) (if (and (> n 2) (tx-int? (nth args 2))) (tx-int (nth args 2)) 0))] 0)
          (and (tx-eq cmd "selftest") (> n 1)) (if (cli-readable? (nth args 1)) (cli-selftest (nth args 1)) (let [z (cli-out (:text (cli-missing (nth args 1))))] 3))
          (tx-eq cmd "version") (cli-out (tx-cat3 "kumitate " (mc-version) "\n"))
          :else (let [o (cli-run args) z (if (= (:code o) 2) (cli-err (:text o)) (cli-out (:text o)))] (:code o)))))
