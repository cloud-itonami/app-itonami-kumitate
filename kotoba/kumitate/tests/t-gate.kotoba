;; tests/t-gate: the gate's entry (kotoba/kumitate/GATE-MANIFEST). Prints
;; PASS or FAIL for each test-* and returns how many passed; the expected
;; result is 18. A test that is skipped cannot pass: every one is called.
(defn t-run [name :string ok :bool] :i64
  (let [r (typed-cap-call :io/write :string :string (tx-cat3 (if ok "PASS " "FAIL ") name "\n"))]
    (if ok 1 0)))
(defn main [] :i64
  (+ (t-run "yaml-scalars" (test-yaml-scalars)) (t-run "yaml-blocks" (test-yaml-blocks))
     (t-run "yaml-collections" (test-yaml-collections)) (t-run "yaml-anchors" (test-yaml-anchors))
     (t-run "yaml-refusals" (test-yaml-refusals)) (t-run "emit-roundtrip" (test-emit-roundtrip))
     (t-run "json" (test-json)) (t-run "regex" (test-regex)) (t-run "expr" (test-expr))
     (t-run "iso-uuid" (test-iso-uuid)) (t-run "xml" (test-xml)) (t-run "plan-matrix" (test-plan-matrix))
     (t-run "plan-refusals" (test-plan-refusals)) (t-run "plan-filters" (test-plan-filters))
     (t-run "plan-expand" (test-plan-expand)) (t-run "runs" (test-runs)) (t-run "junit" (test-junit))
     (t-run "mcp" (test-mcp))))
